# Copy to .env (gitignored) and fill in. For local runs this file wins over machine-wide variables.

# Free tier used to measure the AI features (aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Anthropic: the production design target (takes priority over Gemini when set)
ANTHROPIC_API_KEY=

# auto | anthropic | gemini | offline
SI_LLM_PROVIDER=auto

# Hard daily cap for app LLM traffic, in USD
SI_LLM_DAILY_BUDGET_USD=2
